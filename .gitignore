# Runtime / secrets (never commit)
/var/*
!/var/.gitkeep
/data/
*.sqlite
*.sqlite3
*.db
jwt.secret
*.secret
.env
.env.*
!.env.example
!**/.env.example

# Apache / local overrides
.devbox-db.php
*.local.php

# Logs & caches
*.log
/tmp/
rate_limit/

# OS / editor
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp
*~

# Dependencies / tooling
/node_modules/
/vendor/
composer.lock

# Captured source assets
image_*.jpg
image_*.png

# Unlisted / hidden public pages
/public/_x/
