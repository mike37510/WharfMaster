# Copier vers .env puis adapter (ou utiliser le pack ZIP généré depuis WharfMaster).

WHARFMASTER_URL=https://VOTRE-SERVEUR
JOIN_TOKEN=wmj_VOTRE_TOKEN
ADVERTISE_URL=https://IP_DU_NOEUD:9001
NODE_NAME=mon-serveur

# Port publié sur l’hôte
AGENT_HOST_PORT=9001

# CN du certificat TLS autosigné (défaut = hostname de ADVERTISE_URL)
# AGENT_TLS_CN=192.168.1.5
AGENT_TLS_DAYS=365

# Répertoire hôte pour les stacks Compose déployées par l’agent
STACKS_DIR=/var/lib/wharfmaster/stacks

# Image tag après build local (laisser tel quel en général)
AGENT_IMAGE=wharfmaster-agent:local

# Rempli automatiquement par ./deploy.sh après le join :
# NODE_SECRET=
