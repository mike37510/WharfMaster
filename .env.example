# Copier vers .env si besoin : cp .env.example .env

# Port publié sur l’hôte
WHARFMASTER_PORT=9000

# GID du groupe propriétaire du socket Docker
# Linux : stat -c '%g' /var/run/docker.sock
DOCKER_GID=999

# Chemin du socket sur l’hôte (montage compose)
DOCKER_SOCK_PATH=/var/run/docker.sock
# Chemin vu *dans* l’app / le conteneur (si ce n’est pas docker.sock, ex. docker.so)
# DOCKER_SOCKET=/var/run/docker.sock

DOCKER_API_VERSION=v1.45
